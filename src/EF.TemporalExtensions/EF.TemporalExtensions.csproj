<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>EF.TemporalExtensions</PackageId>
    <Version>1.0.0</Version>
    <Authors>DaveRogala</Authors>
    <Description>
      Extends EF Core's IsTemporal() fluent API with a HasRetentionPeriod() method,
      automatically emitting the correct ALTER TABLE … SET (SYSTEM_VERSIONING = ON
      (HISTORY_RETENTION_PERIOD = …)) SQL in migrations.
    </Description>
    <PackageTags>efcore;entityframework;temporal;retention;sqlserver;migrations</PackageTags>
    <RepositoryUrl>https://github.com/DaveRogala/EF-Temporal-Extension</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

</Project>
